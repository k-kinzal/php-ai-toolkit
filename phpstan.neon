includes:
    - extension-src.neon

parameters:
    paths:
        - src
        - tests
    excludePaths:
        - tests/Fixture
    bootstrapFiles:
        - phpstan-stubs/bootstrap.php
    customRules:
        broadCatchAllowedPaths:
            - 'src/PhpStan/Rule/Shared/FileTokenParser.php'
            # A forked documentation worker is a process boundary: whatever
            # goes wrong inside it has to be turned into a message the parent
            # can report, because a failure that only reaches the worker's
            # own stack would leave the run with a silently incomplete site.
            - 'src/DocGen/Parallel/WorkerPool.php'
            # Doctest evaluates the example text a docblock carries, which is
            # arbitrary program code: whatever it raises has to become a
            # reported failure, because a throwable that escaped here would end
            # the run at the first broken example instead of reporting it
            # alongside the others. This is the only file that runs that text,
            # so it is the only place the catch is needed.
            - 'src/Doctest/Executor/ExpressionEvaluator.php'
        mixedArrayReturnAllowedPaths:
            # The serialized cache is intentionally untyped at this lowest
            # storage boundary. ParseCache and RenderCache validate their own
            # precise shapes immediately after reading it.
            - 'src/DocGen/Cache/CacheStore.php'
            # Doctest evaluates arbitrary example code. The variables that code
            # defines can therefore be any PHP value; the context is the one
            # boundary that carries them between evaluations.
            - 'src/Doctest/Executor/ExecutionContext.php'
    ignoreErrors:
        # PHPStan's ErrorFormatterTestCase and related internal classes
        # (ErrorsConsoleStyle, SymfonyOutput, SymfonyStyle) are not marked
        # with @api, unlike RuleTestCase which is BC-promised.
        #
        # However, ErrorFormatterTestCase is the ONLY way to construct a
        # valid Output object for testing. PHPStan bundles Symfony Console
        # under a vendor-prefixed namespace (_PHPStan_*\Symfony\...), so
        # the standard Symfony classes cannot satisfy the type requirements
        # of ErrorsConsoleStyle::__construct(). Attempting to construct
        # Output manually results in a TypeError.
        #
        # See: https://github.com/phpstan/phpstan/discussions (no @api on ErrorFormatterTestCase)
        -
            identifier: phpstanApi.class
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesAiErrorFormatterTest.php
        -
            identifier: phpstanApi.method
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesAiErrorFormatterTest.php
        -
            identifier: phpstanApi.constructor
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesAiErrorFormatterTest.php
        -
            identifier: phpstanApi.class
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesErrorFormatterTest.php
        -
            identifier: phpstanApi.method
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesErrorFormatterTest.php
        -
            identifier: phpstanApi.constructor
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesErrorFormatterTest.php
        -
            identifier: phpstanApi.class
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesHumanErrorFormatterTest.php
        -
            identifier: phpstanApi.method
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesHumanErrorFormatterTest.php
        -
            identifier: phpstanApi.constructor
            path: tests/Unit/PhpStan/ErrorFormatter/AiRulesHumanErrorFormatterTest.php
        -
            identifier: phpstanApi.constructor
            path: tests/Unit/PhpStan/ErrorFormatter/ErrorCollectionSummaryTest.php
        -
            identifier: phpstanApi.constructor
            path: tests/Unit/PhpStan/ErrorFormatter/ErrorGroupingTest.php
        -
            identifier: phpstanApi.constructor
            path: tests/Unit/PhpStan/ErrorFormatter/ErrorGutterTest.php
        -
            identifier: phpstanApi.constructor
            path: tests/Unit/PhpStan/ErrorFormatter/HumanErrorPrinterTest.php
        -
            identifier: phpstanApi.constructor
            path: tests/Unit/PhpStan/ErrorFormatter/HumanFileErrorPrinterTest.php
