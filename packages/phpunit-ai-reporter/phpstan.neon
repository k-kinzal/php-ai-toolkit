includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/phpstan-guard-rules/rules.neon
    - vendor/k-kinzal/phpstan-ai-formatter/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests/Unit
    excludePaths:
        - fixtures
    bootstrapFiles:
        - phpstan-stubs/bootstrap.php
    toolkit:
        allRules: true
        # Analysis-only stubs declare legacy PHPUnit symbols unavailable in this runtime.
        forbiddenDependencies!:
            -
                from: ['*/**']
                excludeFrom: ['tests/**', 'vendor/**']
                to: ['*/**']
                excludeTo: ['src/**', 'vendor/**', 'phpstan-stubs/**']
                allowSameRootDirectory: true
            -
                from: ['tests/**']
                to: ['*/**']
                excludeTo: ['src/**', 'vendor/**', 'fixtures/**', 'phpstan-stubs/**']
                allowSameRootDirectory: true
        broadCatchAllowedPaths:
            - src/Doctest/Executor/ExpressionEvaluator.php
