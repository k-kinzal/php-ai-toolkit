includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - rules.neon
    - vendor/k-kinzal/phpstan-ai-formatter/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests/Unit
    excludePaths:
        - tests/PhpStan
    toolkit:
        allRules: true
        classPairExclude:
            - Tests\Unit\Compatibility\ClassAliasesTest
            - Tests\Unit\PhpStan\Rule\Naming\ForbidClassLikeNameSuffixRuleWithoutConfiguredSuffixesTest
            - Tests\Unit\PhpStan\Rule\Naming\ForbiddenNamespaceRuleWithoutConfiguredPrefixesTest
