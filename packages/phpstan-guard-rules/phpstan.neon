includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - rules.neon
    - allow-test-fixtures.neon
    - vendor/k-kinzal/phpstan-ai-formatter/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests/Unit
    excludePaths:
        - fixtures
    toolkit:
        allRules: true
