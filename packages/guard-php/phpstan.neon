includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/phpstan-guard-rules/rules.neon
    - vendor/k-kinzal/phpstan-ai-formatter/extension.neon

parameters:
    level: max
    stubFiles:
        - phpstan-stubs/neon.stub
    paths:
        - src
        - tests/Unit
    toolkit:
        allRules: true
        # Constructor arguments cross from untyped YAML into external component code here.
        broadCatchAllowedPaths:
            - src/Config/ComponentLoader.php
