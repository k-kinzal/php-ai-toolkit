{
    "name": "k-kinzal/docgen-php",
    "description": "Generate PHP API documentation and coverage sites",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "nikic/php-parser": "^4.19 || ^5.0",
        "phpstan/phpdoc-parser": "^1.33 || ^2.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Toolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "classmap": [
            "fixtures/"
        ],
        "exclude-from-classmap": [
            "vendor/marc-mabe/php-enum/stubs/Stringable.php"
        ]
    },
    "bin": [
        "bin/docgen"
    ],
    "suggest": {
        "ext-gd": "Draws the social preview image of a generated documentation site (needs FreeType support)"
    },
    "require-dev": {
        "brianium/paratest": "^6.11 || ^7",
        "deptrac/deptrac": "^0.24 || ^1.0 || ^2.0 || ^3.0 || ^4.6",
        "friendsofphp/php-cs-fixer": "^3.4",
        "infection/infection": "^0.26.19 || ^0.27 || ^0.28 || ^0.29 || ^0.30 || ^0.31 || ^0.32 || ^0.33 || ^0.34 || ^0.35",
        "k-kinzal/guard-php": "^1.0 || dev-main",
        "k-kinzal/phpstan-ai-formatter": "^1.0 || dev-main",
        "k-kinzal/phpstan-guard-rules": "^1.0 || dev-main",
        "k-kinzal/phpunit-ai-reporter": "^1.0 || dev-main",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11 || ^12 || ^13",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "autoload:check": "composer dump-autoload --optimize --strict-psr --strict-ambiguous",
        "test": "@php -d memory_limit=512M tests/run.php --parallel --processes=auto",
        "test:unit": "@php -d memory_limit=512M tests/run.php",
        "test:unit:9": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit9.xml.dist",
        "test:unit:10": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit10.xml.dist",
        "test:unit:11": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit11.xml.dist",
        "test:unit:12": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit12.xml.dist",
        "test:unit:13": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist",
        "test:unit:legacy": "@test:unit:9",
        "test:coverage": "@php -d memory_limit=1G -d xdebug.mode=coverage tests/run.php --coverage-xml build/coverage-xml",
        "doctest": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite doctest",
        "lint": [
            "@autoload:check",
            "@format:check",
            "@phpstan",
            "@compat",
            "@guard",
            "@deptrac"
        ],
        "phpstan": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml",
        "infection": "infection --threads=max",
        "guard": "guard check",
        "guard:fix": "guard fix",
        "docgen": "@php bin/docgen --exclude=fixtures/*"
    },
    "scripts-descriptions": {
        "autoload:check": "Check that the PSR-4 mapping is unambiguous before the other lint gates.",
        "format:check": "Check PHP-CS-Fixer formatting without writing files.",
        "phpstan": "Run PHPStan with the toolkit rules.",
        "compat": "Check PHP syntax against the declared version range.",
        "guard": "Check source metrics, structure, documents, and tool configuration.",
        "deptrac": "Check architecture layer dependencies.",
        "test:unit": "Run the unit test suite.",
        "lint": "Run the fast gates, starting with the autoload check.",
        "docgen": "Generate the API documentation site."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../guard-php",
            "options": {
                "symlink": true,
                "versions": {
                    "k-kinzal/guard-php": "dev-main"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../phpstan-guard-rules",
            "options": {
                "symlink": true,
                "versions": {
                    "k-kinzal/phpstan-guard-rules": "dev-main"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../phpunit-ai-reporter",
            "options": {
                "symlink": true,
                "versions": {
                    "k-kinzal/phpunit-ai-reporter": "dev-main"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../phpstan-ai-formatter",
            "options": {
                "symlink": true,
                "versions": {
                    "k-kinzal/phpstan-ai-formatter": "dev-main"
                },
                "reference": "config"
            }
        }
    ]
}
