includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/phpstan-guard-rules/rules.neon
    - vendor/k-kinzal/phpstan-ai-formatter/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests/Unit
    excludePaths:
        - tests/Fixture
    bootstrapFiles:
        - phpstan-stubs/bootstrap.php
    toolkit:
        allRules: true
        broadCatchAllowedPaths:
            - src/Doctest/Executor/ExpressionEvaluator.php
