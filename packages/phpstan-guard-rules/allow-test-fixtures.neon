# Opt-in root-directory boundary for projects with test-owned files in fixtures/.
# Include after rules.neon. This replaces the default dependency policy list.
parameters:
    toolkit:
        forbiddenDependencies!:
            -
                from: ['*/**']
                excludeFrom: ['tests/**', 'vendor/**']
                to: ['*/**']
                excludeTo: ['src/**', 'vendor/**']
                allowSameRootDirectory: true
            -
                from: ['tests/**']
                to: ['*/**']
                excludeTo: ['src/**', 'vendor/**', 'fixtures/**']
                allowSameRootDirectory: true
