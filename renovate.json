{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["composer", "github-actions"],
  "timezone": "Asia/Tokyo",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "composer": {
    "rangeStrategy": "widen",
    "constraints": {"php": "8.5.*"},
    "composerIgnorePlatformReqs": ["ext-*"],
    "postUpdateOptions": ["composerWithAll"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Keep the supported PHP baseline unchanged",
      "matchManagers": ["composer"],
      "matchPackageNames": ["php"],
      "enabled": false
    }
  ]
}
