<?xml version="1.0"?>
<ruleset name="phpunit-ai-reporter">
    <description>Checks compatibility with the declared PHP support range.</description>
    <file>src</file>
    <file>tests</file>
    <exclude-pattern>*/tests/Doctest/*</exclude-pattern>
    <exclude-pattern>*/tests/TestReporter/*</exclude-pattern>
    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
