includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/phpstan-guard-rules/rules.neon
    - vendor/k-kinzal/phpstan-ai-formatter/extension.neon

parameters:
    level: max
    stubFiles:
        - phpstan-stubs/neon.stub
    paths:
        - src
        - tests/Unit
    toolkit:
        allRules: true
        # Fixtures and test-support belong to test callers only.
        forbiddenDependencies!:
            -
                from: ['*/**']
                excludeFrom: ['tests/**', 'vendor/**']
                to: ['*/**']
                excludeTo: ['src/**', 'vendor/**']
                allowSameRootDirectory: true
            -
                from: ['tests/**']
                to: ['*/**']
                excludeTo: ['src/**', 'vendor/**', 'fixtures/**', 'test-support/**']
                allowSameRootDirectory: true
