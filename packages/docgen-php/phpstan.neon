includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/phpstan-guard-rules/rules.neon
    - vendor/k-kinzal/phpstan-ai-formatter/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests/Unit
    excludePaths:
        - fixtures
    toolkit:
        allRules: true
        broadCatchAllowedPaths:
            - src/DocGen/Parallel/WorkerPool.php
