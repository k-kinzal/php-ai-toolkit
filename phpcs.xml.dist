<?xml version="1.0"?>
<!-- NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you. -->
<ruleset name="php-ai-toolkit-compat">
    <description>Checks compatibility with the declared PHP support range.</description>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>tests/Fixture/*</exclude-pattern>

    <config name="testVersion" value="8.0-"/>

    <rule ref="PHPCompatibility"/>
</ruleset>
