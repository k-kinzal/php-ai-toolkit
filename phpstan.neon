# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - extension.neon
    - rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - packages/docgen-php/src
        - packages/guard-php/src
        - packages/phpstan-ai-formatter/src
        - packages/phpstan-guard-rules/src
        - packages/phpunit-ai-reporter/src
        - packages/docgen-php/tests/Unit
        - packages/guard-php/tests/Unit
        - packages/phpstan-ai-formatter/tests/Unit
        - packages/phpstan-guard-rules/tests/Unit
        - packages/phpunit-ai-reporter/tests/Unit
    excludePaths:
        - packages/docgen-php/tests/Fixture
        - packages/phpstan-ai-formatter/tests/Fixture
        - packages/phpstan-guard-rules/tests/Fixture
        - packages/phpunit-ai-reporter/tests/Fixture
    stubFiles:
        - phpstan-stubs/neon.stub
    bootstrapFiles:
        - phpstan-stubs/bootstrap.php
    toolkit:
        allRules: true
        broadCatchAllowedPaths:
            - 'packages/docgen-php/src/DocGen/Parallel/WorkerPool.php'
            - 'packages/phpunit-ai-reporter/src/Doctest/Executor/ExpressionEvaluator.php'
    ignoreErrors:
        -
            identifier: phpstanApi.class
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/AiErrorRendererTest.php
        -
            identifier: phpstanApi.method
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/AiErrorRendererTest.php
        -
            identifier: phpstanApi.constructor
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/AiErrorRendererTest.php
        -
            identifier: phpstanApi.class
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/AiErrorFormatterTest.php
        -
            identifier: phpstanApi.method
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/AiErrorFormatterTest.php
        -
            identifier: phpstanApi.constructor
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/AiErrorFormatterTest.php
        -
            identifier: phpstanApi.class
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/HumanErrorRendererTest.php
        -
            identifier: phpstanApi.method
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/HumanErrorRendererTest.php
        -
            identifier: phpstanApi.constructor
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/HumanErrorRendererTest.php
        -
            identifier: phpstanApi.constructor
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/ErrorCollectionSummaryTest.php
        -
            identifier: phpstanApi.constructor
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/ErrorGroupingTest.php
        -
            identifier: phpstanApi.constructor
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/ErrorGutterTest.php
        -
            identifier: phpstanApi.constructor
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/HumanErrorPrinterTest.php
        -
            identifier: phpstanApi.constructor
            path: packages/phpstan-ai-formatter/tests/Unit/PhpStan/ErrorFormatter/HumanFileErrorPrinterTest.php
